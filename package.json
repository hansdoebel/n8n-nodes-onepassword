{
	"name": "n8n-nodes-onepassword",
	"version": "0.1.1",
	"description": "n8n community node to fetch secrets and items from 1Password using a Service Account",
	"license": "MIT",
	"homepage": "https://github.com/hansdoebel/n8n-nodes-onepassword",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"1password",
		"onepassword",
		"secrets",
		"service-account"
	],
	"author": {
		"name": "Hans Doebel",
		"email": "hansdev@mailbox.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hansdoebel/n8n-nodes-onepassword.git"
	},
	"bugs": {
		"url": "https://github.com/hansdoebel/n8n-nodes-onepassword/issues"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/hansdoebel"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/OnePasswordServiceAccountApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/OnePassword/OnePassword.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.28.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "^2.16.0"
	},
	"dependencies": {
		"@1password/sdk": "^0.4.0"
	}
}
